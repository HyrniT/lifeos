{
  "name": "lifeos-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LifeOS — habit, expense and planning super app (user app + admin console)",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --port 5274 --open /admin/",
    "build": "tsc -b --noCheck && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@reduxjs/toolkit": "^2.3.0",
    "antd": "^5.22.2",
    "dayjs": "^1.11.13",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
