# =============================================================================
#  LifeOS — copy to `.env` for local development.
#
#  In production none of this is a file: Render holds the backend's variables
#  and Vercel holds the web app's. See DEPLOYMENT.md.
# =============================================================================

# --- Local Postgres (docker-compose) -----------------------------------------
# 55432 so it cannot collide with a Postgres you already run on 5432.
POSTGRES_PORT=55432
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=lifeos_secret

# --- Backend -----------------------------------------------------------------
# Read by the application when you run it outside the IDE.
DATABASE_URL=jdbc:postgresql://localhost:55432/lifeos
DATABASE_USERNAME=lifeos
DATABASE_PASSWORD=lifeos_secret

# MUST be at least 64 bytes for HS512. Under the `prod` profile the application
# refuses to start on this value.  Generate one with:  openssl rand -base64 96
JWT_SECRET=change-me-in-production-this-must-be-at-least-64-bytes-long-for-hs512-algorithm

# The seeded administrator. Turn the seed off once you have a real account.
ADMIN_SEED_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Where the web app is served from. Comma-separated, no trailing slash.
LIFEOS_CORS_ORIGINS=http://localhost:5273,http://localhost:4273

# --- Browser push (optional) --------------------------------------------------
# Leave empty and push is off; in-app notifications are unaffected.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@lifeos.local

# --- Google sign-in (optional) ------------------------------------------------
# Leave empty and the button hides itself.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5273/auth/google/callback

# --- Web app ------------------------------------------------------------------
# Empty in development: Vite proxies /api to localhost:9080, so the browser sees
# one origin. In production set this to the backend's public URL.
VITE_API_BASE_URL=
